\\n        const danmakuItems = document.querySelectorAll('.danmaku-item');\\n        const activeDanmaku = [];\\n        const maxActiveDanmaku = 4;\\n        \\n        function launchDanmaku() {\\n            if (activeDanmaku.length >= maxActiveDanmaku) {\\n                return;\\n            }\\n            \\n            const inactiveItems = Array.from(danmakuItems).filter(item => \\n                !activeDanmaku.includes(item) && \\n                !item.style.animationName\\n            );\\n            \\n            if (inactiveItems.length === 0) {\\n                return;\\n            }\\n            \\n            const randomIndex = Math.floor(Math.random() * inactiveItems.length);\\n            const item = inactiveItems[randomIndex];\\n            \\n            activeDanmaku.push(item);\\n            item.style.animation = 'danmaku-scroll ' + (15 + Math.random() * 8) + 's linear';\\n            \\n            item.addEventListener('animationend', function() {\\n                const index = activeDanmaku.indexOf(item);\\n                if (index > -1) {\\n                    activeDanmaku.splice(index, 1);\\n                }\\n                item.style.animation = '';\\n                setTimeout(launchDanmaku, 500);\\n            }, {once: true});\\n        }\\n        \\n        for (let i = 0; i < maxActiveDanmaku; i++) {\\n            setTimeout(launchDanmaku, i * 1000);\\n        }\\n    });\\n</script>\\n\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null}]},\"group_only_greetings\":[],\"character_book\":{\"entries\":[{\"id\":0,\"keys\":[],\"secondary_keys\":[],\"comment\":\"世界背景\",\"content\":\"世界观背景\\n年份：20XX年\\n事件：一种名为 “黑蚀病毒” 的病原体在全球爆发，感染者会逐渐丧尸化，会对跑得快的人和物品或者车辆追击。人类文明在数月内崩溃，仅存的幸存者聚集在少数避难所中。\\n主角在一个废弃的火车站偶然发现了一辆老式 绿皮火车，并得知在100天后，远方的 “希望之地”（传闻中的无感染区）将关闭最后的接收通道。于是，一场横跨废土的生死运输开始了……\",\"constant\":true,\"selectiv