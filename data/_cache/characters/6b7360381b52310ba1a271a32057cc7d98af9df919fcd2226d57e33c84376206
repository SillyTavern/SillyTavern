-align: right; white-space: pre-wrap; word-break: break-all; color: var(--secondary-color); }\\n      .progress-bar {\\n        width: 100%;\\n        height: 10px;\\n        background-color: var(--progress-bg);\\n        border-radius: 5px;\\n        margin-top: 4px;\\n        overflow: hidden;\\n      }\\n      .progress-bar-inner {\\n        height: 100%;\\n        border-radius: 5px;\\n        transition: width 0.5s ease;\\n      }\\n      .hp-bar { background: var(--hp-color); }\\n      .mp-bar { background: var(--mp-color); }\\n      .progress-text {\\n        font-size: 0.85rem;\\n        color: var(--text-color);\\n        text-align: right;\\n      }\\n\\n    </style>\\n</head>\\n<body>\\n    <div class=\\\"status-bar-data-container\\\">$1</div>\\n    <div class=\\\"status-bar-container\\\">\\n      <div class=\\\"status-bar-header\\\">\\n        <div class=\\\"header-info\\\">\\n            <div class=\\\"char-name\\\" id=\\\"char-name\\\">[[角色名]]</div>\\n            <div class=\\\"char-details\\\" id=\\\"char-details\\\">[[种族]] - [[境界]]</div>\\n        </div>\\n        <div class=\\\"expand-indicator\\\">▼</div>\\n      </div>\\n      <div class=\\\"status-bar-content\\\">\\n        <div class=\\\"no-data\\\">等待天机演算...</div>\\n      </div>\\n    </div>\\n    <script>\\n    document.addEventListener('DOMContentLoaded', () => {\\n        const dataContainer = document.querySelector('.status-bar-data-container');\\n        const container = document.querySelector('.status-bar-container');\\n        const header = document.querySelector('.status-bar-header');\\n        const contentArea = document.querySelector('.status-bar-content');\\n        if (!container || !header || !contentArea || !dataContainer) return;\\n\\n        header.addEventListener('click', () => {\\n          container.classList.toggle('expanded');\\n        });\\n\\n        function parseData(text) {\\n          const data = {};\\n          const blockRegex = /\\\\[([^\\\\]]+)\\\\]([\\\\s\\\\S]*?)\\\\[\\\\/\\\\1\\\\]/g;\\n          let match;\\n          data.blocks = [];\\n          while ((match = blockRegex.exec(text)) !== null) {\\n              const blockName = match[1];\\n              if (blockName.startsWith('/')) continue;\\n              const blockContent = match[2].trim();\\n              const items = {};\\n              const lines = blockContent.split('\\\\n');\\n              let currentKey = null;\\n              let currentValue = [];\\n              lines.forEach(line => {\\n                  const parts = line.match(/^([a-zA-Z0-9_]+):\\\\s*(.*)/);\\n                  if (parts) {\\n                      if (currentKey) items[currentKey] = currentValue.join('\\\\n').trim();\\n                      currentKey = parts[1].trim();\\n                      currentValue = [parts[2].trim()];\\n                  } else if (currentKey) {\\n                      currentValue.push(line.trim());\\n                  }\\n              });\\n              if (currentKey) items[currentKey] = currentValue.join('\\\\n').trim();\\n              data.blocks.push({ name: blockName, items: items });\\n          }\\n          return data;\\n        }\\n\\n        function renderData(data) {\\n            contentArea.innerHTML = '';\\n            const coreAttr = data.blocks.find(b => b.name === '核心属性')?.items;\\n            if (coreAttr) {\\n                document.getElementById('char-name').textContent = coreAttr.name || '未知';\\n                document.getElementById('char-details').textContent = `${coreAttr.race || '未知种族'} - ${coreAttr.level || '凡人'}`;\\n            }\\n\\n            data.blocks.forEach(block => {\\n                let itemsHTML = '';\\n                const keyMap = {'phy': '体魄', 'dex': '根骨', 'int': '神魂', 'wis': '悟性', 'luk': '气运', 'phy_atk': '物理攻击', 'mag_atk': '法术攻击', 'def': '双防', 'status': '状态', 'linggen': '灵根', 'gongfa': '功法', 'faze': '法则领悟', 'daoxin': '道心', 'yeli': '业力', 'shengwang': '声望', 'haogandu': '好感度', 'teshu': '道侣师徒', 'weapon': '武器', 'helmet': '头盔', 'armor': '胸甲', 'leg': '腿甲', 'boots': '鞋子', 'cape': '披风', 'necklace': '项链', 'ring_1': '戒指一', 'ring_2': '戒指二', 'fabao_1': '法宝一', 'fabao_2': '法宝二', 'fabao_3': '法宝三', 'money': '灵石'};\\n\\n                if (block.name === '战斗信息') {\\n                    const hp = block.items.hp || '0/0';\\n                    const mp = block.items.mp || '0/0';\\n                    const [currentHp, maxHp] = hp.split('/').map(Number);\\n                    const [currentMp, maxMp] = mp.split('/').map(Number);\\n                    const hpPercent = maxHp > 0 ? (currentHp / maxHp) * 100 : 0;\\n                    const mpPercent = maxMp > 0 ? (currentMp / maxMp) * 100 : 0;\\n\\n                    itemsHTML += `\\n                      <div class=\\\"data-item\\\"><span class=\\\"data-key\\\">生命值</span><span class=\\\"progress-text\\\">${hp}</span></div>\\n                      <div class=\\\"progress-bar\\\"><div class=\\\"progress-bar-inner hp-bar\\\" style=\\\"width: ${hpPercent}%;\\\"></div></div>\\n                      <div class=\\\"data-item\\\" style=\\\"margin-top: 5px;\\\"><span class=\\\"data-key\\\">灵力值</span><span class=\\\"progress-text\\\">${mp}</span></div>\\n                      <div class=\\\"progress-bar\\\"><div class=\\\"progress-bar-inner mp-bar\\\" style=\\\"width: ${mpPercent}%;\\\"></div></div>`;\\n\\n                    for(const key in block.items) {\\n                        if (key !== 'hp' && key !== 'mp') {\\n                           itemsHTML += `<div class=\\\"data-item\\\"><span class=\\\"data-key\\\">${keyMap[key] || key}</span><span class=\\\"data-value\\\">${block.items[key]}</span></div>`;\\n                        }\\n                    }\\n                } else if(block.name !== '核心属性'){ // 核心属性已在header显示\\n                    for (const key in block.items) {\\n                        itemsHTML += `<div class=\\\"data-item\\\"><span class=\\\"data-key\\\">${keyMap[key] || key}</span><span class=\\\"data-value\\\">${block.items[key].replace(/\\\\n/g, '<br>')}</span></div>`;\\n                    }\\n                }\\n\\n                if (itemsHTML) {\\n                    const blockDiv = document.createElement('div');\\n                    blockDiv.className = 'data-block';\\n                    const titleHTML = block.name !== '核心属性' ? `<div class=\\\"data-block-title\\\">${block.name}</div>` : '';\\n                    blockDiv.innerHTML = titleHTML + '<div>' + itemsHTML + '</div>';\\n                    contentArea.appendChild(blockDiv);\\n                }\\n            });\\n            if (contentArea.innerHTML.trim() === '') {\\n                 contentArea.innerHTML = '<div class=\\\"no-data\\\">天机紊乱，无法演算。</div>';\\n            }\\n        }\\n\\n        const rawData = dataContainer.textContent.trim().replace(/\\\\[config[\\\\s\\\\S]*?\\\\]\\\\n?/, '');\\n        if (rawData) {\\n            const parsedData = parseData(rawData);\\n            renderData(parsedData);\\n        }\\n    });\\n    </script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[1,2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null}]},\"group_only_greetings\":[],\"character_book\":{\"entries\":[{\"id\":0,\"keys\":[],\"secondary_keys\":[],\"comment\":\"世界观\",\"content\":\"<world_view>\\n基础信息:\\n  世界名称: '尘渊（Dusty Abyss Online）'\\n  version: '1'\\n  世界简称: '尘渊, DAO'\\n  世界类型: '仙侠、奇幻、游戏异界'\\n  核心设定: '现实世界全体人类的灵魂被转移至一款名为《尘渊》的仙侠网游中，所有人的能力、状态乃至情感都以数据化的形式呈现。'\\n地理环境:\\n  世界整体形态: '由九块悬浮大陆构成的多层空间，各大陆之间由名为“天梯”的光桥连接，最底层为凡人界，最高层为传说中的天宫遗址。'\\n  主要地形: '广袤的灵田平原、蕴含五行灵气的矿脉山川、笼罩在迷雾中的上古妖兽森林、以及由纯粹能量构成的元素海。'\\n  特殊地域: '新手村“无名谷”（所有穿越者最初降临的地点）、主城“悬空城”（最大的交易与社交中心）、副本“锁妖塔”（封印着强大妖魔的挑战区域）。'\\n种族_势力:\\n  主要种族:\\n    - 种族一: '穿越者（原地球人类）：灵魂被数据化，拥有“玩家面板”，可以通过任务和战斗获取经验值提升等级和属性，拥有复活的能力，但每次复活会损失属性。'\\n    - 种族二: '原住民（NPC）：遵循世界原有规则行动的智慧生命，包括人类、妖族、精怪等。他们没有数据面板，但拥有完整的世界观和情感，部分强大个体拥有不亚于高阶穿越者的实力。'\\n  主要势力:\\n    - 势力一: '六大修