"1.1\\\"\\n                                xmlns=\\\"http://www.w3.org/2000/svg\\\" p-id=\\\"1547\\\" width=\\\"200\\\" height=\\\"200\\\">\\n                                <path\\n                                    d=\\\"M253.482667 85.333333a53.333333 53.333333 0 0 1 52.608 44.586667l39.466666 236.544a53.333333 53.333333 0 0 1-28.8 56.533333l-82.56 41.216a588.586667 588.586667 0 0 0 325.589334 325.589334l41.301333-82.56a53.333333 53.333333 0 0 1 56.448-28.8l236.544 39.466666A53.333333 53.333333 0 0 1 938.666667 770.56v114.816A53.333333 53.333333 0 0 1 885.333333 938.666667h-106.666666C395.733333 938.666667 85.333333 628.266667 85.333333 245.333333v-106.666666A53.333333 53.333333 0 0 1 138.666667 85.333333h114.816z m578.56 53.333334a53.333333 53.333333 0 0 1 37.674666 91.050666L800.768 298.666667l68.949333 68.949333a53.333333 53.333333 0 0 1-75.434666 75.434667L725.333333 374.101333l-68.949333 68.949334a53.333333 53.333333 0 1 1-75.434667-75.434667L649.941333 298.666667l-68.992-68.949334a53.333333 53.333333 0 0 1 75.434667-75.434666L725.333333 223.274667l68.949334-68.992a53.333333 53.333333 0 0 1 37.717333-15.616z\\\"\\n                                    fill=\\\"#ffffff\\\" p-id=\\\"1548\\\"></path>\\n                            </svg>\\n                        </button>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- Chat messages -->\\n        <div id=\\\"chat\\\" class=\\\"flex-1 p-3 flex flex-col space-y-2 overflow-y-auto text-sm scrollbar-hide hidden\\\">\\n            <!-- Chat messages will be added here -->\\n        </div>\\n\\n        <!-- Control buttons at bottom -->\\n        <div id=\\\"controlButtons\\\" class=\\\"bg-black bg-opacity-90 p-4 flex justify-center space-x-4 relative z-16\\\">\\n            <button id=\\\"startVoiceBtn\\\"\\n                class=\\\"px-6 py-2 bg-gray-700 hover:bg-gray-600 rounded-full text-white font-medium transition-colors text-sm\\\">\\n                语音通话\\n            </button>\\n            <button id=\\\"startVideoBtn\\\"\\n                class=\\\"px-6 py-2 bg-gray-700 hover:bg-gray-600 rounded-full text-white font-medium transition-colors text-sm\\\">\\n                视频通话\\n            </button>\\n        </div>\\n    </div>\\n\\n    <script>\\n        const callMode = \\\"$2\\\";\\n        // 通话数据配置\\n        const callData = {\\n            contact: {\\n                name: \\\"$1\\\",\\n                avatar: \\\"$4\\\"\\n            },\\n            voiceScenarios: [\\n                $5\\n            ],\\n            videoScenarios: [\\n                $5\\n            ]\\n        };\\n\\n        // 界面元素\\n        const callArea = document.getElementById('callArea');\\n        const voiceInterface = document.getElementById('voiceCallInterface');\\n        const videoInterface = document.getElementById('videoCallInterface');\\n        const voiceMessages = document.getElementById('voiceMessages');\\n        const videoMessages = document.getElementById('videoMessages');\\n        const startVoiceBtn = document.getElementById('startVoiceBtn');\\n        const startVideoBtn = document.getElementById('startVideoBtn');\\n        const controlButtons = document.getElementById('controlButtons');\\n        const statusText = document.getElementById('statusText');\\n        const chatHeader = document.getElementById('chat-header');\\n        const chatArea = document.getElementById('chat');\\n\\n        const voiceInput = document.getElementById('voiceInput');\\n        const videoInput = document.getElementById('videoInput');\\n        const voiceSendBtn = document.getElementById('voiceSendBtn');\\n        const videoSendBtn = document.getElementById('videoSendBtn');\\n        const voiceEndBtn = document.getElementById('voiceEndBtn');\\n        const videoEndBtn = document.getElementById('videoEndBtn');\\n\\n        // 通话状态\\n        let isCallActive = false;\\n        let callType = '';\\n        let callTimer = null;\\n        let callDuration = 0;\\n        let scenarioIndex = 0;\\n        let scenarioTimer = null;\\n        let callEndedBy = 'me'; // 'me' 或 'other'，默认为我方挂断\\n\\n        // 音效\\n        const callStartSound = new Audio('https://files.catbox.moe/km8f2q.mp3');\\n        const callEndSound = new Audio('https://files.catbox.moe/qh6mpb.mp3');\\n\\n        // 开始语音通话\\n        startVoiceBtn.addEventListener('click', () => {\\n            startCall('voice');\\n        });\\n        // 开始视频通话\\n        startVideoBtn.addEventListener('click', () => {\\n            startCall('video');\\n        });\\n\\n        // 通话界面挂断按钮事件\\n        voiceEndBtn.addEventListener('click', () => {\\n            callEndedBy = 'me';\\n            endCall();\\n\\n            if (typeof triggerSlash === 'function') {\\n                triggerSlash(`/send 查看$1发来的消息（{{user}}挂断了语音通话）|/trigger`);\\n            }\\n        });\\n\\n        videoEndBtn.addEventListener('click', () => {\\n            callEndedBy = 'me';\\n            endCall();\\n\\n            if (typeof triggerSlash === 'function') {\\n                triggerSlash(`/send 查看$1发来的消息（{{user}}挂断了视频通话）|/trigger`);\\n            }\\n        });\\n\\n        // 语音通话发送按钮事件\\n        voiceSendBtn.addEventListener('click', () => {\\n            sendMessage(voiceInput, voiceMessages);\\n        });\\n\\n        // 视频通话发送按钮事件\\n        videoSendBtn.addEventListener('click', () => {\\n            sendMessage(videoInput, videoMessages);\\n        });\\n\\n        // 输入框回车事件\\n        voiceInput.addEventListener('keydown', (e) => {\\n            if (e.key === 'Enter' && !e.shiftKey) {\\n                e.preventDefault();\\n                sendMessage(voiceInput, voiceMessages);\\n            }\\n        });\\n\\n        videoInput.addEventListener('keydown', (e) => {\\n            if (e.key === 'Enter' && !e.shiftKey) {\\n                e.preventDefault();\\n                sendMessage(videoInput, videoMessages);\\n            }\\n        });\\n\\n        // 开始通话逻辑\\n        function startCall(type) {\\n            if (isCallActive) return;\\n\\n            isCallActive = true;\\n            callType = type;\\n            callDuration = 0;\\n            scenarioIndex = 0;\\n\\n            // 隐藏聊天界面，显示通话界面\\n            chatArea.classList.add('hidden');\\n            callArea.classList.remove('hidden');\\n\\n            // 播放通话开始音效\\n            callStartSound.play().catch(() => { });\\n\\n            // 更新状态和联系人信息\\n            if (statusText) {\\n                statusText.textContent = type === 'voice' ? '语音通话中' : '视频通话中';\\n            }\\n            document.getElementById('voiceContactName').textContent = callData.contact.name;\\n            document.getElementById('videoContactName').textContent = callData.contact.name;\\n            document.getElementById('voiceAvatar').src = `https://files.catbox.moe/${callData.contact.avatar}`;\\n            document.getElementById('videoAvatar').src = `https://files.catbox.moe/${callData.contact.avatar}`;\\n\\n            chatHeader.classList.add('hidden');\\n            // 显示对应界面\\n            if (type === 'voice') {\\n                voiceInterface.classList.remove('hidden');\\n                voiceInterface.classList.add('fade-in-zoom');\\n                videoInterface.classList.add('hidden');\\n                voiceMessages.innerHTML = '';\\n            } else {\\n                videoInterface.classList.remove('hidden');\\n                videoInterface.classList.add('fade-in-zoom');\\n                voiceInterface.classList.add('hidden');\\n                videoMessages.innerHTML = '';\\n            }\\n\\n            // 隐藏控制按钮\\n            controlButtons.classList.add('hidden');\\n\\n            // 启动计时器和场景播放\\n            startTimer();\\n            playNextScenario();\\n        }\\n\\n        // 发送消息函数\\n        function sendMessage(inputElement, messageContainer) {\\n            const messageText = inputElement.value.trim();\\n            if (!messageText) return;\\n\\n            // 清空输入框\\n            inputElement.value = '';\\n\\n            // 滚动到底部\\n            setTimeout(() => {\\n                messageContainer.scrollTop = messageContainer.scrollHeight;\\n            }, 50);\\n\\n            // 模拟触发命令\\n            if (typeof triggerSlash === 'function') {\\n                triggerSlash(`/send 回应了和$1的通话：${messageText}|/trigger`);\\n            }\\n        }\\n\\n        // 挂断通话\\n        function endCall() {\\n            if (!isCallActive) return;\\n\\n            // 记录通话总时长\\n            const finalDuration = callDuration;\\n            const finalCallType = callType;\\n\\n            isCallActive = false;\\n\\n            // 播放通话结束音效\\n            callEndSound.play().catch(() => { });\\n\\n            // 停止所有计时器\\n            if (callTimer) {\\n                clearInterval(callTimer);\\n                callTimer = null;\\n            }\\n            if (scenarioTimer) {\\n                clearTimeout(scenarioTimer);\\n                scenarioTimer = null;\\n            }\\n\\n            // 重置界面\\n            voiceInterface.classList.add('hidden');\\n            videoInterface.classList.add('hidden');\\n            controlButtons.classList.remove('hidden');\\n            chatHeader.classList.remove('hidden');\\n            statusText.textContent = '10:30';\\n\\n            // 显示聊天界面\\n            chatArea.classList.remove('hidden');\\n\\n            // 创建通话记录气泡\\n            createCallRecordBubble(finalCallType, finalDuration, callEndedBy);\\n        }\\n\\n        // 计时器\\n        function startTimer() {\\n            callTimer = setInterval(() => {\\n                callDuration++;\\n                const minutes = Math.floor(callDuration / 60).toString().padStart(2, '0');\\n                const seconds = (callDuration % 60).toString().padStart(2, '0');\\n                const timeStr = `${minutes}:${seconds}`;\\n\\n                document.getElementById('voiceCallTime').textContent = timeStr;\\n                document.getElementById('videoCallTime').textContent = timeStr;\\n            }, 1000);\\n        }\\n\\n        // 延迟更新时间随机版\\n        function getRandomDuration(min = 1000, max = 5000) {\\n            return Math.floor(Math.random() * (max - min + 1)) + min;\\n        }\\n\\n        function playNextScenario() {\\n            if (!isCallActive) return;\\n\\n            const scenarios = callType === 'voice' ? callData.voiceScenarios : callData.videoScenarios;\\n\\n            // 检查是否已经播放完所有场景\\n            if (scenarioIndex >= scenarios.length) {\\n                return; // 不再循环播放\\n            }\\n\\n            const scenario = scenarios[scenarioIndex];\\n            addMessage(scenario);\\n\\n            // 检查当前消息是否包含\\\"已挂断通话\\\"的字样\\n            if (scenario.description && scenario.description.includes(\\\"已挂断通话\\\")) {\\n                callEndedBy = 'other';\\n                setTimeout(() => {\\n                    endCall();\\n\\n                    const chatTarget = document.querySelector('.font-bold.text-base')?.textContent?.trim() || '对方';\\n                    const chatCallType = callType === 'voice' ? \\\"语音\\\" : \\\"视频\\\";\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send 查看${chatTarget}发来的消息（${chatTarget}挂断了${chatCallType}通话）|/trigger`);\\n                    }\\n                }, 4200);\\n                return;\\n            }\\n\\n            scenarioIndex++;\\n\\n            // 设置出现下一条讯息\\n            const randomDuration = getRandomDuration(1500, 3000);\\n            scenarioTimer = setTimeout(() => {\\n                playNextScenario();\\n            }, randomDuration);\\n        }\\n\\n        // 更新下一条\\n        function addMessage(scenario) {\\n            const container = document.createElement('div');\\n            container.className = 'message-container message-enter';\\n\\n            const speechDiv = document.createElement('div');\\n            speechDiv.className = 'speech-content';\\n\\n            const descriptionDiv = document.createElement('div');\\n            descriptionDiv.className = 'description-content';\\n\\n            if (callType === 'voice') {\\n                const speakerClass = scenario.speaker === '我' ? 'speaker-me' : 'speaker-other';\\n                speechDiv.innerHTML = `<span class=\\\"${speakerClass}\\\">${scenario.speaker}:</span> ${scenario.speech}`;\\n                descriptionDiv.textContent = scenario.description;\\n                voiceMessages.appendChild(container);\\n            } else {\\n                const speakerClass = scenario.speaker === '我' ? 'speaker-me' : 'speaker-other';\\n                speechDiv.innerHTML = `<span class=\\\"${speakerClass}\\\">${scenario.speaker}:</span> ${scenario.speech}`;\\n                descriptionDiv.textContent = scenario.description;\\n                videoMessages.appendChild(container);\\n            }\\n\\n            container.appendChild(speechDiv);\\n            container.appendChild(descriptionDiv);\\n\\n            // 滚动到底部逻辑\\n            const messagesContainer = callType === 'voice' ? voiceMessages : videoMessages;\\n            setTimeout(() => {\\n                messagesContainer.scrollTop = messagesContainer.scrollHeight;\\n            }, 50);\\n        }\\n\\n        // 挂断通话并创建通话记录气泡\\n        function createCallRecordBubble(type, duration, endedBy) {\\n            const minutes = Math.floor(duration / 60).toString().padStart(2, '0');\\n            const seconds = (duration % 60).toString().padStart(2, '0');\\n            const calltime = `${minutes}:${seconds}`;\\n\\n            const wrapper = document.createElement('div');\\n            wrapper.classList.add('flex', 'items-start', 'space-x-2', 'my-2');\\n\\n            const bubble = document.createElement('div');\\n            bubble.classList.add('bubble-pop', 'call-record-bubble');\\n\\n            // 设置图标\\n            const iconSvg = type === 'voice'\\n                ? '<svg class=\\\"w-4 h-4\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M6.6,10.8c1.7,3.4,4.2,6,7.5,7.5l2.5-2.5c0.3-0.3,0.7-0.4,1.1-0.3c1.2,0.4,2.5,0.6,3.8,0.6c0.6,0,1,0.4,1,1v3.8c0,0.6-0.4,1-1,1C11.5,22,2,12.5,2,2.8c0-0.6,0.4-1,1-1h3.8c0.6,0,1,0.4,1,1c0,1.3,0.2,2.6,0.6,3.8c0.1,0.4,0,0.8-0.3,1.1L6.6,10.8z\\\"/></svg>'\\n                : '<svg class=\\\"w-4 h-4\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M17 10.5V6c0-1.1-.9-2-2-2H5C3.9 4 3 4.9 3 6v12c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-4.5l4 4v-11l-4 4z\\\"/></svg>';\\n\\n            // 构建气泡内容\\n            const statusText = endedBy === 'me' ? '已挂断' : '对方已挂断通话';\\n\\n            if (endedBy === 'me') {\\n                // 我方挂断，显示在右侧\\n                wrapper.classList.add('justify-end');\\n                bubble.innerHTML = `\\n                    <div class=\\\"call-record-icon text-yellow-500\\\">${iconSvg}</div>\\n                    <div class=\\\"call-record-info\\\">\\n                        <div>${statusText}</div>\\n                        <div class=\\\"call-record-duration\\\">通话时长：${calltime}</div>\\n                    </div>\\n                `;\\n\\n            } else {\\n                // 对方挂断，显示在左侧\\n                const avatar = document.createElement('img');\\n                avatar.src = `https://files.catbox.moe/${callData.contact.avatar}`;\\n                avatar.alt = '头像';\\n                avatar.className = 'w-8 h-8 rounded-full object-cover mt-1';\\n                wrapper.appendChild(avatar);\\n\\n                bubble.innerHTML = `\\n                    <div class=\\\"call-record-icon text-yellow-500\\\">${iconSvg}</div>\\n                    <div class=\\\"call-record-info\\\">\\n                        <div>${statusText}</div>\\n                        <div class=\\\"call-record-duration\\\">通话时长：${calltime}</div>\\n                    </div>\\n                `;\\n            }\\n            wrapper.appendCh