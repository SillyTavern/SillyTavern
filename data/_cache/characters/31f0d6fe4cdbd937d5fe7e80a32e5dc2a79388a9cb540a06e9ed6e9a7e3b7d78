z.mp3');\\n\\n        // 多消息存储\\n        let holdMessages = [];\\n        let holdModeActive = false;\\n\\n        // 多功能状态\\n        let activeMediaType = null;\\n        let transferAmount = '';\\n        let voiceDuration = 0;\\n        let voiceTimer = null;\\n\\n        // 聚焦输入框音效\\n        input.addEventListener('focus', () => {\\n            clickAudio.play().catch(() => { });\\n        });\\n\\n        // 回车发送\\n        input.addEventListener('keydown', (e) => {\\n            if (e.key === 'Enter') {\\n                e.preventDefault();\\n                if (holdModeActive) {\\n                    addToHold();\\n                } else {\\n                    sendBtn.click();\\n                }\\n            }\\n        });\\n\\n        // 切换Hold模式\\n        holdButton.addEventListener('click', () => {\\n            clickAudio.play().catch(() => { });\\n            holdModeActive = !holdModeActive;\\n\\n            if (holdModeActive) {\\n                holdButton.classList.add('active');\\n                holdPanel.style.display = 'block';\\n                // 强制重绘以触发动画\\n                void holdPanel.offsetWidth;\\n\\n                holdPanel.classList.add('active');\\n                input.focus();\\n                input.placeholder = \\\"输入消息…（hold模式中）\\\";\\n            } else {\\n                holdButton.classList.remove('active');\\n                input.placeholder = \\\"输入消息…\\\";\\n                // if (holdMessages.length === 0) {\\n                holdPanel.classList.remove('active');\\n                // 动画结束后隐藏面板\\n                setTimeout(() => {\\n                    if (!holdPanel.classList.contains('active')) {\\n                        holdPanel.style.display = 'none';\\n                    }\\n                }, 300);\\n                // }\\n            }\\n        });\\n\\n        // 添加消息到Hold列表\\n        function addToHold() {\\n            const text = input.value.trim();\\n            if (!text) return;\\n\\n            // 根据当前激活的功能格式化消息\\n            let formattedText = text;\\n            if (activeMediaType === 'image') {\\n                formattedText = `[媒体消息::${text}]`;\\n            } else if (activeMediaType === 'voice') {\\n                formattedText = `[语音消息::${Math.floor(Math.random() * 10 + 5)}::${text}]`;\\n            } else if (activeMediaType === 'transfer') {\\n                formattedText = `[转账消息::${transferAmount}::`;\\n                if (text) {\\n                    formattedText += `${text}]`;\\n                } else {\\n                    formattedText += '无备注]';\\n                }\\n            }\\n\\n            holdMessages.push(formattedText);\\n            renderHoldItems();\\n            input.value = '';\\n            input.focus();\\n        }\\n\\n        // 渲染Hold列表\\n        function renderHoldItems() {\\n            holdItems.innerHTML = '';\\n            holdCount.textContent = `${holdMessages.length} 条消息`;\\n\\n            holdMessages.forEach((msg, index) => {\\n                const item = document.createElement('div');\\n                item.className = 'hold-item';\\n                if (msg.includes(\\\"[随机骰子\\\")) {\\n                    item.innerHTML = `\\n                        <div class=\\\"hold-item-content\\\">${msg}</div>\\n                        <div class=\\\"hold-item-delete\\\" data-index=\\\"${index}\\\" style=\\\"pointer-events: none !important;display: none;\\\">\\n                            <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\">\\n                                <line x1=\\\"18\\\" y1=\\\"6\\\" x2=\\\"6\\\" y2=\\\"18\\\"></line>\\n                                <line x1=\\\"6\\\" y1=\\\"6\\\" x2=\\\"18\\\" y2=\\\"18\\\"></line>\\n                            </svg>\\n                        </div>\\n                    `;\\n                } else {\\n                    item.innerHTML = `\\n                        <div class=\\\"hold-item-content\\\">${msg}</div>\\n                        <div class=\\\"hold-item-delete\\\" data-index=\\\"${index}\\\">\\n                            <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\">\\n                                <line x1=\\\"18\\\" y1=\\\"6\\\" x2=\\\"6\\\" y2=\\\"18\\\"></line>\\n                                <line x1=\\\"6\\\" y1=\\\"6\\\" x2=\\\"18\\\" y2=\\\"18\\\"></line>\\n                            </svg>\\n                        </div>\\n                    `;\\n                }\\n                holdItems.appendChild(item);\\n            });\\n\\n            // 删除\\n            document.querySelectorAll('.hold-item-delete').forEach(btn => {\\n                btn.addEventListener('click', (e) => {\\n                    const index = parseInt(e.currentTarget.dataset.index);\\n                    holdMessages.splice(index, 1);\\n                    renderHoldItems();\\n                });\\n            });\\n        }\\n\\n        // 发送Hold中的所有消息\\n        holdSendBtn.addEventListener('click', () => {\\n            if (holdMessages.length === 0) return;\\n            sendAudio.play().catch(() => { });\\n            const formattedMessages = holdMessages.map(msg => `\\\"${msg}\\\"`).join(',');\\n            if (typeof triggerSlash === 'function') {\\n                triggerSlash(`/send 回复$1的消息：${formattedMessages}|/trigger`);\\n            }\\n            holdMessages.forEach(msg => {\\n                sendMessage(msg);\\n            });\\n\\n            // 重置Hold状态\\n            holdMessages = [];\\n            holdModeActive = false;\\n            holdButton.classList.remove('active');\\n            holdPanel.classList.remove('active');\\n            setTimeout(() => {\\n                holdPanel.style.display = 'none';\\n                input.placeholder = \\\"输入消息…\\\";\\n            }, 300);\\n        });\\n\\n        // 发送单条消息\\n        function sendMessage(text) {\\n            // 查找最后一条消息时间\\n            const allContainers = Array.from(chat.querySelectorAll('.bubble-container'));\\n            let lastTime = '12:00'; // 默认时间\\n            if (allContainers.length > 0) {\\n                const lastContainer = allContainers[allContainers.length - 1];\\n                const timeEl = lastContainer.querySelector('.time-stamp');\\n                if (timeEl) {\\n                    lastTime = timeEl.textContent.trim();\\n                }\\n            }\\n            const [hh, mm] = lastTime.split(':').map(Number);\\n\\n            // 随机加时间\\n            let newMinutes = mm + Math.floor(Math.random() * 3);\\n            let newHours = hh;\\n            if (newMinutes >= 60) {\\n                newMinutes -= 60;\\n                newHours = (hh + 1) % 24;\\n            }\\n\\n            const time = `${newHours.toString().padStart(2, '0')}:${newMinutes.toString().padStart(2, '0')}`;\\n\\n            // 显示我方新气泡\\n            const newMsg = createBubble({ sender: 'me', text, time });\\n            chat.appendChild(newMsg);\\n            chat.scrollTop = chat.scrollHeight;\\n        }\\n\\n        // 点击发送按钮后，构造消息\\n        sendBtn.addEventListener('click', () => {\\n            const text = input.value.trim();\\n            if (!text && !activeMediaType) return;\\n\\n            if (holdModeActive) {\\n                addToHold();\\n                return;\\n            }\\n            sendAudio.play().catch(() => { });\\n\\n            let messageText = text;\\n            if (activeMediaType === 'image') {\\n                messageText = `[媒体消息::${text}]`;\\n            } else if (activeMediaType === 'voice') {\\n                messageText = `[语音消息::${Math.floor(Math.random() * 10 + 5)}::${text}]`;\\n            } else if (activeMediaType === 'transfer') {\\n                messageText = `[转账消息::${transferAmount}::`;\\n                if (text) {\\n                    messageText += `{text}]`;\\n                } else {\\n                    messageText += '无备注]';\\n                }\\n            }\\n\\n            // 模拟触发命令\\n            if (typeof triggerSlash === 'function') {\\n                triggerSlash(`/send 回复$1的消息：${messageText}|/trigger`);\\n            }\\n\\n            sendMessage(messageText);\\n            input.value = '';\\n\\n            deactivateMediaType();\\n        });\\n\\n        // 更新消息气泡\\n        function createBubble(message) {\\n            const wrapper = document.createElement('div');\\n            wrapper.classList.add('flex', 'items-start', 'space-x-2', 'mb-2');\\n\\n            if (message.sender === 'me') {\\n                wrapper.classList.add('justify-end');\\n                if (message.text.includes(\\\"挂断了\\\") && message.text.includes(\\\"通话\\\")) {\\n                    // 通话挂断气泡\\n                    let iconSvg = ''\\n                    if (message.text.includes(\\\"语音\\\")) {\\n                        iconSvg = '<svg class=\\\"w-4 h-4\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M6.6,10.8c1.7,3.4,4.2,6,7.5,7.5l2.5-2.5c0.3-0.3,0.7-0.4,1.1-0.3c1.2,0.4,2.5,0.6,3.8,0.6c0.6,0,1,0.4,1,1v3.8c0,0.6-0.4,1-1,1C11.5,22,2,12.5,2,2.8c0-0.6,0.4-1,1-1h3.8c0.6,0,1,0.4,1,1c0,1.3,0.2,2.6,0.6,3.8c0.1,0.4,0,0.8-0.3,1.1L6.6,10.8z\\\"/></svg>'\\n                    } else if (message.text.includes(\\\"视频\\\")) {\\n                        iconSvg = '<svg class=\\\"w-4 h-4\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M17 10.5V6c0-1.1-.9-2-2-2H5C3.9 4 3 4.9 3 6v12c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-4.5l4 4v-11l-4 4z\\\"/></svg>'\\n                    }\\n                    const callbubble = document.createElement('div');\\n                    callbubble.classList.add('bubble-pop', 'call-record-bubble');\\n                    callbubble.innerHTML = `\\n                        <div class=\\\"call-record-icon text-yellow-500\\\">${iconSvg}</div>\\n                        <div class=\\\"call-record-info\\\">\\n                            <div>已挂断</div>\\n                        </div>\\n                    `;\\n                    wrapper.appendChild(callbubble);\\n                } else if (message.text.includes(\\\"[转账消息\\\")) {\\n                    // 转账气泡\\n                    const bubbleContainer = document.createElement('div');\\n                    bubbleContainer.classList.add('bubble-container', 'me');\\n                    const transbubble = document.createElement('div');\\n\\n                    const text = message.text;\\n                    const regex = /\\\\[转账消息\\\\:\\\\:([^\\\\:\\\\:]+?)\\\\:\\\\:([^\\\\]]+?)\\\\]/g;\\n                    const result = text.replace(regex, (match, p1, p2) => {\\n                        return `<div class=\\\"transfer-bubble me\\\">\\n                            <div class=\\\"transfer-header\\\">\\n                                线上转账\\n                            </div>\\n                            <div class=\\\"transfer-amount\\\">¥${p1}</div>\\n                            <div class=\\\"transfer-note\\\">${p2}</div>\\n                            <div class=\\\"transfer-status\\\">\\n                                <span class=\\\"status-text\\\">等待对方接收</span>\\n                            </div>\\n                        </div>\\n                    `;\\n                    });\\n                    transbubble.innerHTML = result;\\n\\n                    bubbleContainer.appendChild(transbubble);\\n                    wrapper.appendChild(bubbleContainer);\\n                } else if (message.text.includes(\\\"[接受了转账]\\\") || message.text.includes(\\\"[退还了转账]\\\")) {\\n                    // 转账状态气泡\\n                    const statusBubble = document.createElement('div');\\n                    statusBubble.classList.add('bubble-pop', 'call-record-bubble');\\n\\n                    const isAccepted = message.text.includes(\\\"[接受了转账]\\\");\\n\\n                    const acceptSvg = `\\n                        <svg class=\\\"w-5 h-5\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\">\\n                            <path d=\\\"M9 12l2 2 4-4\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n                            <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\" fill=\\\"none\\\"/>\\n                            <path d=\\\"M9 12l2 2 4-4\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke=\\\"#10b981\\\" class=\\\"accept-animate\\\"/>\\n                        </svg>\\n                    `;\\n                    const refundSvg = `\\n                        <svg class=\\\"w-5 h-5\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\">\\n                            <path d=\\\"M9 9l6 6m0-6l-6 6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n                            <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\" fill=\\\"none\\\"/>\\n                            <path d=\\\"M9 9l6 6m0-6l-6 6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke=\\\"#ef4444\\\" class=\\\"refund-animate\\\"/>\\n                        </svg>\\n                    `;\\n\\n                    statusBubble.innerHTML = `\\n                        <div class=\\\"call-record-icon ${isAccepted ? 'text-green-500' : 'text-red-500'}\\\">\\n                            ${isAccepted ? acceptSvg : refundSvg}\\n                        </div>\\n                        <div class=\\\"call-record-info\\\">\\n                            <div class=\\\"font-medium\\\">${isAccepted ? '已接收转账' : '已退还转账'}</div>\\n                        </div>\\n                    `;\\n                    wrapper.appendChild(statusBubble);\\n                } else {\\n                    // 普通文本消息\\n                    const bubbleContainer = document.createElement('div');\\n                    bubbleContainer.classList.add('bubble-container', 'me');\\n                    const bubble = document.createElement('div');\\n                    bubble.className = 'bubble-right bg-yellow-300 text-black px-3 py-2 bubble-pop';\\n\\n                    if (message.text.includes(\\\"[媒体消息::\\\")) {\\n                        const text = message.text;\\n                        const regex = /\\\\[媒体消息\\\\:\\\\:([^\\\\]]+?)\\\\]/g;\\n                        const result = text.replace(regex, (match, p1) => {\\n                            return `<div class=\\\"media-card\\\" onclick=\\\"this.classList.toggle('flipped')\\\">\\n                            <div class=\\\"media-card-inner\\\">\\n                                <div class=\\\"media-card-front\\\">\\n                                    <div class=\\\"kaomoji\\\">| ᐕ)⁾⁾</div>\\n                                </div>\\n                                <div class=\\\"media-card-back\\\">${p1}</div></div></div>`\\n                        });\\n                        bubble.innerHTML = result;\\n                    }\\n                    else if (message.text.includes(\\\"[语音消息::\\\")) {\\n                        const text = message.text;\\n                        const regex = /\\\\[语音消息\\\\:\\\\:([^\\\\:\\\\:]+?)\\\\:\\\\:([^\\\\]]+?)\\\\]/g;\\n                        const result = text.replace(regex, (match, p1, p2) => {\\n                            return `\\n                            <div class=\\\"voice-bar\\\">\\n                                <div class=\\\"voice-icon me\\\">\\n                                    <div class=\\\"bar bar1\\\"></div>\\n                                    <div class=\\\"bar bar2\\\"></div>\\n                                    <div class=\\\"bar bar3\\\"></div>\\n                                    <div class=\\\"bar bar4\\\"></div>\\n                                    <div class=\\\"bar bar5\\\"></div>\\n                                </div>\\n                                <div class=\\\"voice-duration\\\">${p1}\\\"</div>\\n                            </div>\\n                  